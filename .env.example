# Upstash Redis (free tier) — cross-device sync, login sessions, presence
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email for magic links (free tier: https://resend.com). Without it, login links are not sent.
RESEND_API_KEY=
EMAIL_FROM=Online Temple <onboarding@resend.dev>

# Set to 1 ONLY for local testing: the API returns the magic link in the response instead of emailing it.
DEV_MAGIC_LINK=
